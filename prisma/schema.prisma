// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ContactRequest {
  id        String   @id @default(cuid())

  name      String
  email     String
  company   String?
  service   String
  budget    String?
  message   String

  status    ContactStatus @default(NEW)

  payments  Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Liste de l'admin : filtre par statut, plus récentes d'abord.
  @@index([status, createdAt])
  @@index([createdAt])
}

// Paiement d'un devis, créé depuis l'admin et réglé via Lemon Squeezy.
// Le statut n'est modifié que par le webhook signé de Lemon Squeezy.
model Payment {
  id          String        @id @default(cuid())
  // Jeton aléatoire du lien public envoyé au client (/pay/<token>).
  token       String        @unique

  clientName  String
  clientEmail String
  description String
  amount      Int           // en centimes, dans la devise de la boutique
  currency    String
  lang        String        @default("fr")

  status      PaymentStatus @default(PENDING)

  contactRequestId String?
  contactRequest   ContactRequest? @relation(fields: [contactRequestId], references: [id], onDelete: SetNull)

  // Commande Lemon Squeezy, renseignée par le webhook.
  orderId     String?       @unique
  orderNumber Int?
  receiptUrl  String?
  testMode    Boolean       @default(false)
  paidAt      DateTime?

  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status, createdAt])
  @@index([contactRequestId])
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  PARTIAL_REFUND
}

// Limitation de débit partagée entre les instances serverless
// (formulaire de contact, tentatives de connexion).
model RateLimit {
  key     String   @id
  count   Int
  resetAt DateTime
}

// Réglages du site modifiables depuis l'admin (une seule ligne, id = 1).
model SiteSettings {
  id        Int      @id @default(1)
  available Boolean  @default(true)
  updatedAt DateTime @updatedAt
}

enum ContactStatus {
  NEW
  CONTACTED
  IN_PROGRESS
  ACCEPTED
  REJECTED
}